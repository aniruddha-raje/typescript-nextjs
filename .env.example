# Base URL of the backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Demo login credentials (mock auth). Defaults to admin/admin if unset.
# NEXT_PUBLIC_* values are shipped to the browser — this is a demo login,
# not a substitute for real authentication.
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=admin
